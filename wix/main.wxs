<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Wake-on-LAN Manager'
        UpgradeCode='E45B21A0-3298-4B1C-8A52-9A4B12345678'
        Manufacturer='Dietmar Schnabel'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer,Wake-on-LAN,Network'
            Description='Cross-platform Wake-on-LAN GUI Desktop Application'
            Manufacturer='Dietmar Schnabel'
            InstallerVersion='300'
            Languages='1033'
            Compressed='yes'
            SummaryCodepage='1252'
        />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed.'
        />

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <!-- Application Icon Setup for Windows Installer & Control Panel (relative to Cargo.toml) -->
        <Icon Id="ProductIcon" SourceFile="assets\icon.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon"/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <!-- Program Files Folder -->
            <Directory Id='ProgramFiles64Folder'>
                <Directory Id='APPLICATIONFOLDER' Name='wol-gui'>
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='wol-gui.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetDir)\release\wol-gui.exe'
                            KeyPath='yes'
                        />
                    </Component>
                </Directory>
            </Directory>

            <!-- Start Menu Programs Folder -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Wake-on-LAN Manager'/>
            </Directory>
        </Directory>

        <!-- Start Menu Shortcut Definition with Custom Icon -->
        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='ApplicationShortcut' Guid='*'>
                <Shortcut
                    Id='ApplicationStartMenuShortcut'
                    Name='Wake-on-LAN Manager'
                    Description='Wake-on-LAN GUI Desktop Application'
                    Target='[APPLICATIONFOLDER]wol-gui.exe'
                    WorkingDirectory='APPLICATIONFOLDER'
                    Icon="ProductIcon"
                    IconIndex="0"
                />
                <RemoveFolder Id='CleanUpShortCut' Directory='ApplicationProgramsFolder' On='uninstall'/>
                <RegistryValue
                    Root='HKCU'
                    Key='Software\DietmarSchnabel\wol-gui'
                    Name='installed'
                    Type='integer'
                    Value='1'
                    KeyPath='yes'
                />
            </Component>
        </DirectoryRef>

        <!-- Features Included in Installer -->
        <Feature Id='MainProgram' Title='Wake-on-LAN Manager' Level='1'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
    </Product>
</Wix>